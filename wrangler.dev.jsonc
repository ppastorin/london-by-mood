{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "london-advanced-d1-prototype",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "GEOCODING_API_URL": "https://nominatim.openstreetmap.org/search",
    "GEOCODING_CACHE_SECONDS": "86400"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "london-advanced-places-dev",
      "database_id": "4a807c8b-7aa0-412f-a623-83a8d6c67f0b",
      "migrations_dir": "migrations"
    }
  ]
}
