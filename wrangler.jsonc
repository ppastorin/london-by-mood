{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "london-by-mood",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "GEOCODING_API_URL": "https://nominatim.openstreetmap.org/search",
    "GEOCODING_CACHE_SECONDS": "86400",
    "ROUTING_API_URL": "https://api.heigit.org/openrouteservice/v2/directions/foot-walking/geojson",
    "TRUST_CF_ACCESS": "true",
    "ADMIN_EMAIL": "paolo.pastorino@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "london-advanced-places",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
